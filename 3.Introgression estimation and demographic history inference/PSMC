# 核心代码展示
1.生成全基因组二倍体一致序列diploid.fq.gz (consensus sequence)
bcftools mpileup -C50 -q20 -Q30 -f /home/data/SQF/GH/Genome/H.marinum/Hma.chr.fa ./BamFile/M2_SB1.final.bam | bcftools call -c | vcfutils.pl vcf2fq -d 5 -D 60 | gzip > ./psmcfa/M2_SB1.final.fq.gz

2.转换为psmcfa格式
while read -r SAMPLE GROUP; do
    fq2psmcfa -q20 psmcfa/${SAMPLE}.fq.gz > psmcfa/${SAMPLE}.psmcfa
done < sample_groups.txt

3.运行bootstrap的PSMC
3.1 #拆分psmcfa文件
while read -r SAMPLE GROUP; do
  splitfa psmcfa/${SAMPLE}.psmcfa > psmcfa/${SAMPLE}.split.psmcfa &
  echo "PSMC 分析任务 ${SAMPLE} 已启动"
done < sample_groups.txt
3.2 #生成psmc文件
psmc -p "4+25*2+4+6" -t25 -N30 -r5 -o diploid.psmc diploid.psmcfa

4.psmc结果整合与绘图 (以M2.1为例)
psmc_plot.pl -u 6.5e-09 -g 0.5 -p -T "SeaBarley PSMC" ./M2.1Plot6.5mu0.5g/SeaBarley_M2.1_SB1Plot ./combine/M2_SB1.finalcombined.psmc
psmc_plot.pl -u 6.5e-09 -g 0.5 -p -T "SeaBarley PSMC" ./M2.1Plot6.5mu0.5g/SeaBarley_M2.1_SB12Plot ./combine/M2_SB12.finalcombined.psmc
cat ./combine/M2_SB1.finalcombined.psmc ./combine/M2_SB12.finalcombined.psmc > ./combine/M2.1combine.psmc 

并行运行代码
#!/bin/bash

# 定义 smc++ estimate 命令的公共参数
common_params="--spline cubic --knots 15 --timepoints 1000 1000000 --cores 20 --regularization-penalty 10 --polarization-error 0.7 --ftol 1e-5 --em-iterations 30"

# 并行运行 smc++ estimate 命令
parallel -j 4 smc++ estimate $common_params -o ./smc++/{1}All 3.66e-09 ./smc++/{1}All/*.smc.gz ::: M2.1 M2.2 G2 G4


2.4 #一次绘制3个或多个群的信息
cp ./M2.1All6.5mu0.5g/model.final.json ./PlotAll6.5mu0.5g/M2.1.model.final.json
cp ./M2.2All6.5mu0.5g/model.final.json ./PlotAll6.5mu0.5g/M2.2.model.final.json
cp ./G2All6.5mu0.5g/model.final.json ./PlotAll6.5mu0.5g/G2.model.final.json

smc++ plot ./PlotAll6.5mu0.5g/SeaBarley.EffPopSizeExceptG4.pdf ./PlotAll6.5mu0.5g/M2.1.model.final.json ./PlotAll6.5mu0.5g/M2.2.model.final.json ./PlotAll6.5mu0.5g/G2.model.final.json -g 0.5 --ylim 0 100000000 -c

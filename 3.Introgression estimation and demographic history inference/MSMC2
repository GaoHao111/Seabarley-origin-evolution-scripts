2.有效种群大小和交叉溯祖率绘制 (.R)
mu <- 6.5e-9
gen <- 0.5
M2subgr1Dat<-read.table("within_pop1_M2subgr1.final.txt", header=TRUE)
M2subgr2Dat<-read.table("within_pop2_M2subgr2.final.txt", header=TRUE)
G2Dat<-read.table("within_pop3_G2.final.txt", header=TRUE)

plot(G2Dat$left_time_boundary/mu*gen, (1/G2Dat$lambda)/(2*mu), log="x",ylim=c(0,100000),
     type="n", xlab="Years ago", ylab="effective population size")

lines(M2subgr1Dat$left_time_boundary/mu*gen, (1/M2subgr1Dat$lambda)/(2*mu), type="s", col="red")
lines(M2subgr2Dat$left_time_boundary/mu*gen, (1/M2subgr2Dat$lambda)/(2*mu), type="s", col="blue")
lines(G2Dat$left_time_boundary/mu*gen, (1/G2Dat$lambda)/(2*mu), type="s", col="yellow")
legend("topright",legend=c("M2subgr1", "M2subgr2", "G2"), col=c("red", "blue","yellow"), lty=c(1,1))


crossPop12Dat<-read.table("combined_pop1_pop2.final.txt", header=TRUE)
crossPop13Dat<-read.table("combined_pop1_pop3.final.txt", header=TRUE)
crossPop23Dat<-read.table("combined_pop2_pop3.final.txt", header=TRUE)
plot(crossPop13Dat$left_time_boundary/mu*gen, 2 * crossPop13Dat$lambda_01 / (crossPop13Dat$lambda_00 + crossPop13Dat$lambda_11),
     xlim=c(1000,500000),ylim=c(0,1), type="n", xlab="Years ago", ylab="relative cross-coalescence rate")
lines(crossPop12Dat$left_time_boundary/mu*gen, 2 * crossPop12Dat$lambda_01 / (crossPop12Dat$lambda_00 + crossPop12Dat$lambda_11), type="s")
lines(crossPop13Dat$left_time_boundary/mu*gen, 2 * crossPop13Dat$lambda_01 / (crossPop13Dat$lambda_00 + crossPop13Dat$lambda_11), type="s")
lines(crossPop23Dat$left_time_boundary/mu*gen, 2 * crossPop23Dat$lambda_01 / (crossPop23Dat$lambda_00 + crossPop23Dat$lambda_11), type="s")

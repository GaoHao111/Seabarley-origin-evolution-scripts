cd /home/data/SQF/GH/WholeGenomeSequencing/57Samples_Seabarley
ln -s /home/data/SQF/GH/WholeGenomeSequencing/WildBarley_FromDaifei/WildBarley_Basalt99.snp.filtered.vcf.gz
ln -s /home/data/SQF/GH/WholeGenomeSequencing/WildBarley_FromDaifei/WildBarley_Basalt99.snp.filtered.vcf.gz.csi

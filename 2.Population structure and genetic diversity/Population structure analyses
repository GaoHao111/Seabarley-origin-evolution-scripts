2.ADMIXTURE analysis (ADMIXTURE v1.3.0; pong v1.5)
K_START=2
K_END=8
REPEATS=3

for K in $(seq $K_START $K_END); do
  for REP in $(seq 1 $REPEATS); do
    SEED=$RANDOM  
    echo "Running K=$K, Rep=$REP, Seed=$SEED"
  
    admixture -s $SEED --cv 93SeaBarley_ForPopStruct_int.bed $K -j40 \
      > log_K${K}_rep${REP}.out 2>&1
    
    mv 93SeaBarley_ForPopStruct_int.$K.P 93SeaBarley_ForPopStruct_int_K${K}_rep${REP}.P
    mv 93SeaBarley_ForPopStruct_int.$K.Q 93SeaBarley_ForPopStruct_int_K${K}_rep${REP}.Q
  done
done


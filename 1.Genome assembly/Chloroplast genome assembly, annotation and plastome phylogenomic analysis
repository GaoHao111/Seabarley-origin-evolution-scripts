6.提取超级矩阵并构建最终进化树
6.1 #一键提取共有编码基因 (CDS)
cpstools phy -d 03_annotated_gb -m cds
cd /media/langchao/SQF/GH/GenomeAssembly/ChloroplastGenome/03_annotated_gb/cds

6.2 #高精度多序列比对 (MAFFT)
mafft --auto merge_cds.fasta > aligned_cds.fasta

6.3 #序列修剪去噪 (trimAl)
trimal -in aligned_cds.fasta -out trimmed_cds.fasta -automated1

6.4 #构建最大似然树
iqtree -s trimmed_cds.fasta -m MFP -bb 1000 -alrt 1000 -nt 20


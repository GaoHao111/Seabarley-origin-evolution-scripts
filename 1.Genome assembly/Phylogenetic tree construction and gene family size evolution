2.基于单拷贝同源基因构建物种进化树
2.1 #串联法
2.1.1 #提取每个基因的保守序列
创建脚本ConservedRegionExtraction.sh
for i in *.fa
do
    file=${i%.fa*}
    echo "Processing $file..."
    
    # 多序列比对
    mafft --maxiterate 1000 --localpair "${file}.fa" > "${file}.aln"
    
    # 提取保守序列
    Gblocks "${file}.aln" -b4=5 -b5=h -t=p -e=.gb
    
    # 多行序列转为单行
    seqkit seq "${file}.aln.gb" -w 0 > "${file}.new.aln"
    
    # 使用映射文件替换序列ID
    awk '
    BEGIN {
        # 读取物种映射文件
        idx = 1
        while ((getline line < "species_mapping.txt") > 0) {
            species[idx++] = line
        }
        close("species_mapping.txt")
        current_species = 1
    }
    {
        if (NR%2 == 1) {
            # 奇数行：序列ID行，替换为映射的物种名
            print ">" species[current_species++]
        } else {
            # 偶数行：序列行，原样输出
            print $0
        }
    }' "${file}.new.aln" > "${file}.final.aln"
    
    echo "Completed $file"
done

2.1.2 #基因保守序列整合

创建云图绘制脚本plot_cloud.py
python plot_cloud.py

#脚本如下：
import toytree
import toyplot
import toyplot.pdf
import numpy as np
import matplotlib.pyplot as plt
import matplotlib.colors as mcolors

# 1. 加载数据与理顺拓扑
stree_raw = "((Platifolius:0.252132,(((((((Hgussoneanum:0.00122382,HnothoanatolicumXag:0.00103056)1:0.00746668,Hmarinum:0.00740034)0.967165:0.000440549,HnothoanatolicumXam:0.00727099)1:0.0140955,Hvulgare:0.00140237)1:0.142884,Olatifolia:0.102658)0.901039:0.00866091,Osativa:0.124959)1:0.00797084,(Zmay:0.109544,Othomaeum:0.122826)1:0.0462065)1:0.0583186):0.288793,Acomosus:0.288793);"

# 重根并阶梯化 (ladderize)
stree = toytree.tree(stree_raw).root("Acomosus").mod.ladderize()

# 获取叶节点顺序，并强制将 Acomosus 放在列表最前面（即绘图时的最底部）
tip_order = stree.get_tip_labels()
if tip_order.index("Acomosus") != 0:
    tip_order = tip_order[::-1]

mtrees_raw = toytree.mtree("all_trees_ufboot.tre")
temp_trees = []
rf_distances = []

print("正在解析并处理全部 491 棵基因树...")
for gt in mtrees_raw:
    gt = gt.root("Acomosus")
    gt = gt.mod.collapse_nodes(min_support=50)
    dist = toytree.distance.get_treedist_rf(stree, gt)
    rf_distances.append(dist)
    temp_trees.append(gt)

# 不再进行任何剔除操作，保留完整的 491 棵树
rf_min, rf_max = min(rf_distances), max(rf_distances)

print(f"数据处理完成：共保留 {len(temp_trees)} 棵基因树用于绘制云图。")

# 2. 定制高级红蓝渐变 (Sapphire to Crimson)
custom_colors = ["#08519c", "#e0e0e0", "#a50f15"] 
cmap_custom = mcolors.LinearSegmentedColormap.from_list("SapphireCrimson", custom_colors)
norm = mcolors.Normalize(vmin=rf_min, vmax=rf_max)

# 3. 绘图：缩减宽度的等距展开 DensiTree
# 将宽度由 1600 缩小为 800，高度设为 800 形成 1:1 的紧凑比例
canvas = toyplot.Canvas(width=800, height=800)
axes = canvas.cartesian(label=f"Topological Cloud Tree ({len(temp_trees)} Genes, Colored by RF)")

print("正在绘制云图并修复拓扑排列...")
for gt, d in zip(temp_trees, rf_distances):
    hex_color = mcolors.to_hex(cmap_custom(norm(d)))
    
    gt.draw(
        axes=axes,
        fixed_order=tip_order,
        edge_type='c', 
        use_edge_lengths=False, # 依然保持强制展开，呈现最佳内部结构
        edge_style={
            "stroke": hex_color, 
            "stroke-opacity": 0.08, # 由于 491 棵树全部堆叠，透明度维持 0.08
            "stroke-width": 1.2
        },
        tip_labels=False
    )

# 绘制黑色的物种树骨架
stree.draw(
    axes=axes,
    fixed_order=tip_order,
    edge_type='c', 
    use_edge_lengths=False, 
    edge_style={
        "stroke": "#111111", 
        "stroke-width": 3.5, # 维持纤细精致的黑色实线
        "stroke-opacity": 1.0
    },
    tip_labels=True,
    tip_labels_style={
        "font-size": "15px", 
        "font-weight": "bold", 
        "fill": "#000"
    }
)

# 保存主图
toyplot.pdf.render(canvas, "Species_Gene_DensiTree_Compact.pdf")
print("--> 主图已保存: Species_Gene_DensiTree_Compact.pdf")

# 4. 生成图例
fig, ax = plt.subplots(figsize=(1.2, 5)) 
cbar = fig.colorbar(plt.cm.ScalarMappable(norm=norm, cmap=cmap_custom), cax=ax)
cbar.set_label("Absolute Robinson-Foulds Distance", fontsize=12, fontweight='bold')
ax.tick_params(labelsize=11)

fig.savefig("Colorbar_RedBlue_Legend.pdf", format="pdf", bbox_inches="tight")
plt.close(fig)
print("--> 颜色条已保存: Colorbar_RedBlue_Legend.pdf")

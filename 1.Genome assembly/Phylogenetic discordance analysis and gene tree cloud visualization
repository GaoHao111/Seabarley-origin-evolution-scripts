2.创建脚本UFBootExtract.sh从基因树中提取 UFBoot 支持值
# 生成只包含 UFBoot 支持度的树文件
> all_trees_ufboot.tre
while IFS= read -r tree; do
    # 将 "数字/数字:" 替换为 "第二个数字:"（UFBoot）
    echo "$tree" | sed -E 's/[0-9.]+(\/[0-9.]+(:))/\1/g; s/\///g' >> all_trees_ufboot.tre
done < all_genetrees_species_only.tre

3.创建脚本GoTreeCollapse.sh过滤低支持度分支(bootstrap < 50%)
mkdir -p phyparts_input
> phyparts_input/filtered_trees.tre
while IFS= read -r tree; do
    echo "$tree" > tmp.nwk
    gotree collapse support -i tmp.nwk -s 50 -o tmp_filtered.nwk
    cat tmp_filtered.nwk >> phyparts_input/filtered_trees.tre
done < all_trees_ufboot.tre
rm tmp.nwk tmp_filtered.nwk

